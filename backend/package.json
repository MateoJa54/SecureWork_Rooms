{
  "name": "backend",
  "version": "1.0.0",
  "description": "SecureWork Rooms — backend Node.js + Express + Socket.io",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon",
    "migrate": "node run-migrations.js",
    "test": "jest",
    "test:coverage": "cross-env NODE_ENV=test jest --coverage && start coverage/lcov-report/index.html",
    "test:unit": "cross-env NODE_ENV=test jest src/tests/unit",
    "test:integration": "cross-env NODE_ENV=test jest src/tests/integration",
    "test:load": "node tests/load/load-test-50-users.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.46.0",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "file-type": "^16.5.4",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.11.3",
    "socket.io": "^4.7.4",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "open-cli": "^9.0.0",
    "socket.io-client": "^4.7.4",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverage": true,
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
