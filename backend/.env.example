# Servidor
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Base de datos local (PostgreSQL en Docker)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=securework
DB_USER=securework_user
DB_PASSWORD=cambiar_en_produccion

# Supabase (REQUERIDO para auth del admin)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_JWT_SECRET=para_validar_jwts_emitidos_por_supabase

# Sesiones de usuarios de sala (token efímero propio, NO Supabase)
SESSION_TOKEN_SECRET=otro_secret_largo_minimo_32_caracteres
SESSION_TOKEN_EXPIRES_MIN=15

# CORS
CORS_ORIGIN=*

# Uploads
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=10
